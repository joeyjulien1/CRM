# Application database. The app connects as a role WITHOUT the bypassrls
# attribute so row-level security is actually enforced.
DATABASE_URL=postgres://crm_app:crm_app@localhost:5432/crm

# Migrations and tests run as the owner role, which may create policies.
DATABASE_ADMIN_URL=postgres://postgres@localhost:5432/crm

# Managed Postgres only. Put the provider's CA certificate here so the
# connection is verified as well as encrypted; DATABASE_SSL_NO_VERIFY=1 skips
# verification instead, which is weaker. Neither is needed locally.
DATABASE_CA_CERT=
DATABASE_SSL_NO_VERIFY=

# 32-byte key, base64. Encrypts OAuth tokens at rest.
ENCRYPTION_KEY=

# Session cookie signing key.

# The agent. Config editing is the only place the model runs.
ANTHROPIC_API_KEY=

# Gmail OAuth, per user.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
